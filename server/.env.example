# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daily_grace

# JWT Authentication Secret
JWT_SECRET=super_secret_daily_grace_jwt_key_phase1_dev_change_in_production
JWT_EXPIRES_IN=7d

# SMTP / Email Service Configuration (cPanel / Custom Provider)
EMAIL_HOST=mail.yourdomain.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@yourdomain.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM="Daily Grace" <your_email@yourdomain.com>

# Alternative SMTP_* naming convention (both supported)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@yourdomain.com
SMTP_PASSWORD=your_email_password
SMTP_FROM="Daily Grace" <your_email@yourdomain.com>

# Daily Reminder Scheduler Configuration
DAILY_REMINDER_TIME=05:00
REMINDER_TIMEZONE=Africa/Lagos
ENABLE_REMINDER_SCHEDULER=true


# Application URLs
APP_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
